generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int         @id @default(autoincrement())
  username    String      @db.VarChar
  email       String      @unique @db.VarChar
  password    String      @db.VarChar
  hostedRooms Room[]      @relation("HostUser")
  roomPlayers RoomPlayer[]
  gameHistories GameHistory[]
}

model GameHistory {
  id             Int      @id @default(autoincrement())
  user_id        Int
  room_id        String   @db.Char(6)
  position       Int
  correct_answers Int
  wrong_answers  Int
  played_at      DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Room {
  room_id           String           @id @db.Char(6)
  host_id           Int
  game_name         GameName         @default(trivia)
  status            RoomStatus       @default(waiting)
  max_players       Int              @default(2)
  cur_players       Int              @default(1)
  duration_seconds  Int              @default(120)
  preloading_status PreloadingStatus @default(pending)
  host              User             @relation("HostUser", fields: [host_id], references: [id])
  players           RoomPlayer[]
  roomQuestions     RoomQuestion[]
}

model RoomPlayer {
  id        Int      @id @default(autoincrement())
  user_id   Int      @unique
  room_id   String   @db.Char(6)
  joined_at DateTime @default(now())
  is_ready  Boolean  @default(false)
  room      Room     @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([room_id])
}

model GameQuestion {
  id                Int            @id @default(autoincrement())
  game_name         GameName       @default(trivia)
  category          String?
  difficulty        String?
  question          String
  correct_answer    String
  incorrect_answers Json
  answers           Json
  source            String         @default("opentdb")
  source_hash       String         @unique
  created_at        DateTime       @default(now())
  roomQuestions     RoomQuestion[]
}

model RoomQuestion {
  id             Int          @id @default(autoincrement())
  room_id        String       @db.Char(6)
  question_id    Int
  game_name      GameName     @default(trivia)
  question_index Int
  question_text  String
  category       String?
  difficulty     String?
  answers        Json
  correct_answer String
  created_at     DateTime     @default(now())
  question       GameQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  room           Room         @relation(fields: [room_id], references: [room_id], onDelete: Cascade)

  @@unique([room_id, question_index])
  @@index([room_id])
}

enum RoomStatus {
  waiting
  started
  finished
}

enum GameName {
  trivia
}

enum PreloadingStatus {
  pending
  completed
  failed
}
