// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @db.VarChar
  email         String         @unique @db.VarChar
  password      String         @db.VarChar

  hostedRooms Room[]       @relation("HostUser")
  roomPlayers RoomPlayer[]
}

enum RoomStatus {
  waiting
  started
  finished
}

model Room {
  room_id          String     @id @db.Char(6)
  host_id          Int      
  status           RoomStatus @default(waiting)
  max_players      Int        @default(2)
  cur_players      Int        @default(1)
  duration_seconds Int        @default(120)

  host             User         @relation("HostUser", fields: [host_id], references: [id])
  players          RoomPlayer[]
}

model RoomPlayer {
  id        Int      @id @default(autoincrement())
  user_id   Int      @unique
  room_id   String   @db.Char(6)
  joined_at DateTime @default(now())
  is_ready  Boolean  @default(false)

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [room_id], references: [room_id], onDelete: Cascade)

  @@index([room_id])
}